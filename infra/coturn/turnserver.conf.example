# TURN Server Configuration (coturn)
# This is a template configuration for the coturn TURN server.
# Deploy on a VPS with public IP and open UDP/TCP ports 3478 and 5349.

# Network
listen-ip=0.0.0.0
external-ip=YOUR_PUBLIC_IP
realm=YOUR_TURN_REALM
server-name=YOUR_TURN_HOSTNAME

# Credentials (set via environment or command line)
user=YOUR_TURN_USERNAME:YOUR_TURN_PASSWORD

# Ports
listening-port=3478
listening-ip=0.0.0.0
alt-listening-port=5349

# Protocol
bps-capacity=0
no-tcp-relay

# Relay addresses
relay-ip=YOUR_PUBLIC_IP

# Logging
log-file=/var/log/coturn/turnserver.log
new-log-file-period=daily

# Performance
max-bps=0
bps-capacity=0
