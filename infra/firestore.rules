rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      // Allow reading public profile info
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        resource.data.keys().hasOnly(['username', 'displayName', 'photoURL', 'createdAt', 'lastSeen'])
      );
      
      // Allow writing own profile
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Contacts subcollection
      match /contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Calls collection
    match /calls/{callId} {
      // Allow creation if authenticated and is the caller
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUid;
      
      // Allow reading if authenticated and is participant
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
      
      // Allow updating if authenticated and is participant
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
      
      // Deny delete
      allow delete: if false;
    }
  }
}
